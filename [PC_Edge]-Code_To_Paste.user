// ==UserScript==
// @name         YesOfficer BA Player Controls
// @namespace    nk.yesofficerba.controls
// @version      1.7
// @description  Left/Right = -/+10s, M = mute toggle, hold Space = 2x, tap Space = play/pause, Shift+Up / Shift+Down = speed 1x-3x, Up / Down = volume, hover the timeline = preview picture. Messages show inside the video; controls hide 5s after pausing with Space.
// @match        https://yesofficerba.vercel.app/*
// @grant        none
// @run-at       document-start
// ==/UserScript==

(function () {
  'use strict';

  var SEEK = 10;      // seconds for Left / Right arrow
  var FAST = 2;       // speed while Space is held
  var HOLD_MS = 250;  // hold Space longer than this = 2x, shorter = tap (play/pause)
  var HIDE_AFTER_MS = 5000; // hide the video's control bar this long after pausing with Space
  var SPEEDS = [1, 1.5, 2, 2.5, 3]; // Shift+Up / Shift+Down steps (1x = normal, 3x = maximum)
  var VOL_STEP = 0.1;               // Up / Down arrow change the volume by this much (0.1 = 10%)
  // false: Up / Down always change the volume (they no longer scroll the page).
  // true: only when the mouse is over the video or the video is full screen; elsewhere they scroll as normal.
  var VOLUME_ONLY_OVER_VIDEO = false;

  // Preview picture shown above the timeline when you hover it
  var PREVIEW_ENABLED = true;  // set to false to switch the preview off completely
  var PREVIEW_W = 176;         // width of the preview picture in pixels
  var PREVIEW_QUALITY = 240;   // quality tried for the preview (0 = same quality as the video)
  var SIDE_PAD = 30;           // the timeline starts / ends this far from the video's left / right edge
  var BAND_MIN = 18;           // hover zone: from this many px above the video's bottom edge ...
  var BAND_MAX = 46;           // ... up to this many px above it (this is the timeline row)

  var spaceDown = false;
  var fastActive = false;
  var holdTimer = null;
  var savedRate = 1;
  var holdRate = FAST;

  function getVideo() {
    var list = document.querySelectorAll('video');
    if (!list.length) return null;
    var vids = Array.prototype.slice.call(list);
    for (var i = 0; i < vids.length; i++) {
      if (!vids[i].paused && !vids[i].ended) return vids[i];
    }
    vids.sort(function (a, b) {
      return (b.clientWidth * b.clientHeight) - (a.clientWidth * a.clientHeight);
    });
    return vids[0];
  }

  function isTyping(e) {
    var t = e.target;
    if (!t) return false;
    if (t.isContentEditable) return true;
    var tags = ['INPUT', 'TEXTAREA', 'SELECT'];
    return tags.indexOf(t.tagName) !== -1;
  }

  function isSpace(e) {
    if (e.code === 'Space') return true;
    if (e.key === ' ') return true;
    return false;
  }

  // ---- Hide the video's own control bar while paused ----
  var HIDE_CLASS = 'nk-hide-controls';
  function addStyle() {
    var st = document.createElement('style');
    st.textContent =
      'video.' + HIDE_CLASS + '::-webkit-media-controls{display:none !important;}' +
      'video.' + HIDE_CLASS + '::-webkit-media-controls-enclosure{display:none !important;}' +
      'video.' + HIDE_CLASS + '::-webkit-media-controls-panel{display:none !important;}';
    var where = document.head ? document.head : document.documentElement;
    where.appendChild(st);
  }
  if (document.documentElement) {
    addStyle();
  } else {
    document.addEventListener('DOMContentLoaded', addStyle);
  }

  var hideTimer = null;
  var hideVideo = null;
  var hideActive = false; // true only after pausing with Space

  function showBar() {
    clearTimeout(hideTimer);
    var all = document.querySelectorAll('video');
    for (var i = 0; i < all.length; i++) {
      all[i].classList.remove(HIDE_CLASS);
    }
  }

  // Show the bar now; if the video is paused, hide it again after a few seconds
  function armHide(v) {
    showBar();
    if (!v) return;
    if (!v.paused) return;
    hideActive = true;
    hideVideo = v;
    hideTimer = setTimeout(function () {
      if (hideVideo) {
        if (hideVideo.paused) hideVideo.classList.add(HIDE_CLASS);
      }
    }, HIDE_AFTER_MS);
  }

  // Any mouse or touch activity brings the bar back (and re-arms the timer while paused)
  function onActivity() {
    var v = getVideo();
    if (!v) return;
    if (hideActive) {
      if (v.paused) armHide(v);
    }
  }
  window.addEventListener('mousemove', onActivity, true);
  window.addEventListener('mousedown', onActivity, true);
  window.addEventListener('touchstart', onActivity, true);

  // Playing again always shows the normal controls behaviour
  document.addEventListener('play', function () { hideActive = false; showBar(); }, true);
  document.addEventListener('ended', function () { hideActive = false; showBar(); }, true);

  // Drop keyboard focus from the video's built-in controls so the control bar
  // can fade out again by itself (it stays visible while a control has focus).
  function releaseFocus(v) {
    try {
      var a = document.activeElement;
      if (!a) return;
      if (a === v) {
        v.blur();
      } else if (a.tagName === 'VIDEO') {
        a.blur();
      }
    } catch (err) {}
  }

  // ---- Message shown inside the video ----
  // In full screen the message must live inside the full-screen element,
  // otherwise the browser hides it.
  function host() {
    var f = document.fullscreenElement;
    if (f) {
      if (f.tagName !== 'VIDEO') return f;
    }
    return document.body;
  }

  var toastEl = null;
  var toastTimer = null;
  var toastHideTimer = null;
  var usePopover = false;

  function makeToast() {
    toastEl = document.createElement('div');
    toastEl.style.cssText =
      'position:fixed;inset:auto;margin:0;border:0;overflow:visible;width:auto;height:auto;' +
      'transform:translateX(-50%);z-index:2147483647;' +
      'background:rgba(0,0,0,.75);color:#fff;padding:6px 14px;border-radius:6px;' +
      'font:15px sans-serif;opacity:0;transition:opacity .2s;pointer-events:none;';
    if (typeof toastEl.showPopover === 'function') {
      // A "popover" is drawn in the browser's top layer, which sits above
      // a full-screen video too.
      toastEl.setAttribute('popover', 'manual');
      usePopover = true;
    }
  }

  function toast(msg) {
    if (!document.body) return;
    if (!toastEl) makeToast();

    if (usePopover) {
      if (toastEl.parentNode !== document.body) document.body.appendChild(toastEl);
    } else {
      var h = host();
      if (toastEl.parentNode !== h) h.appendChild(toastEl);
    }

    // Place it at the top centre of the video; if there is no video, top of the page
    var v = getVideo();
    var left = window.innerWidth / 2;
    var top = 20;
    if (v) {
      var r = v.getBoundingClientRect();
      left = r.left + r.width / 2;
      top = Math.max(r.top, 0) + 16;
    }
    toastEl.style.left = left + 'px';
    toastEl.style.top = top + 'px';

    toastEl.textContent = msg;
    toastEl.style.opacity = '1';

    if (usePopover) {
      // Hide then show again so it goes to the very front of the top layer
      try { toastEl.hidePopover(); } catch (e1) {}
      try { toastEl.showPopover(); } catch (e2) {}
    }

    clearTimeout(toastTimer);
    clearTimeout(toastHideTimer);
    toastTimer = setTimeout(function () {
      toastEl.style.opacity = '0';
      if (usePopover) {
        toastHideTimer = setTimeout(function () {
          try { toastEl.hidePopover(); } catch (e3) {}
        }, 300);
      }
    }, 700);
  }

  // ---- Preview picture when hovering the timeline ----
  // A hidden second copy of the video jumps to the time under the mouse and its
  // frame is drawn in a small box above the timeline. The video's own player is
  // not touched, and nothing is loaded until you first hover the timeline.
  var pvEl = null;
  var pvCanvas = null;
  var pvLabel = null;
  var pvCtx = null;
  var pvVideo = null;
  var pvSrc = '';
  var pvLow = false;
  var pvFailed = false;
  var pvBusy = false;
  var pvBusyTimer = null;
  var pvPending = -1;
  var pvIdle = null;
  var pvPopover = false;

  function fmt(sec) {
    if (!(sec > 0)) sec = 0;
    sec = Math.floor(sec);
    var h = Math.floor(sec / 3600);
    var m = Math.floor((sec % 3600) / 60);
    var x = sec % 60;
    var ss = (x < 10 ? '0' : '') + x;
    if (h > 0) return h + ':' + (m < 10 ? '0' : '') + m + ':' + ss;
    return m + ':' + ss;
  }

  // The same address with a lower quality number, if the address has one
  function lowQualityUrl(src) {
    if (!PREVIEW_QUALITY) return src;
    try {
      var u = new URL(src);
      var inner = u.searchParams.get('url');
      if (!inner) return src;
      var changed = inner.replace(/([?&]bitrate=)\d+/, '$1' + PREVIEW_QUALITY);
      if (changed === inner) return src;
      u.searchParams.set('url', changed);
      return u.toString();
    } catch (err) {
      return src;
    }
  }

  function drawPreview() {
    if (!pvVideo) return;
    if (!pvCtx) return;
    try {
      pvCtx.drawImage(pvVideo, 0, 0, pvCanvas.width, pvCanvas.height);
    } catch (err) {}
  }

  function seekPreview(t) {
    if (!pvVideo) return;
    if (pvVideo.readyState < 1) {
      pvPending = t;
      return;
    }
    if (pvVideo.duration > 0) {
      if (isFinite(pvVideo.duration)) t = Math.min(t, pvVideo.duration - 0.2);
    }
    if (t < 0) t = 0;
    if (Math.abs(pvVideo.currentTime - t) < 0.05) {
      drawPreview();
      return;
    }
    if (pvBusy) {
      pvPending = t;
      return;
    }
    pvBusy = true;
    pvPending = -1;
    clearTimeout(pvBusyTimer);
    pvBusyTimer = setTimeout(function () { pvBusy = false; }, 2500);
    try {
      if (typeof pvVideo.fastSeek === 'function') {
        pvVideo.fastSeek(t);
      } else {
        pvVideo.currentTime = t;
      }
    } catch (err) {
      pvBusy = false;
    }
  }

  function makePvVideo(url) {
    if (pvVideo) {
      pvVideo.removeAttribute('src');
      try { pvVideo.load(); } catch (e0) {}
    }
    var el = document.createElement('video');
    pvVideo = el;
    el.muted = true;
    el.preload = 'metadata';
    el.setAttribute('playsinline', '');
    el.addEventListener('loadedmetadata', function () {
      if (el !== pvVideo) return;
      if (pvPending >= 0) seekPreview(pvPending);
    });
    el.addEventListener('seeked', function () {
      if (el !== pvVideo) return;
      pvBusy = false;
      clearTimeout(pvBusyTimer);
      drawPreview();
      if (pvPending >= 0) {
        var t = pvPending;
        pvPending = -1;
        seekPreview(t);
      }
    });
    el.addEventListener('error', function () {
      if (el !== pvVideo) return;
      pvBusy = false;
      if (pvLow) {
        // the lower-quality address did not work: use the normal one instead
        pvLow = false;
        makePvVideo(pvSrc);
      } else {
        pvFailed = true;
        hidePreview();
      }
    });
    el.src = url;
  }

  // Make sure the hidden copy exists for the video's current address
  function ensurePreview(v) {
    var src = v.currentSrc;
    if (!src) return false;
    if (src.indexOf('blob:') === 0) return false;   // a stream that cannot be copied
    if (pvVideo) {
      if (pvSrc === src) return !pvFailed;
    }
    pvSrc = src;
    pvFailed = false;
    pvPending = -1;
    pvBusy = false;
    var low = lowQualityUrl(src);
    pvLow = low !== src;
    makePvVideo(low);
    return true;
  }

  function buildPreviewBox() {
    pvEl = document.createElement('div');
    pvEl.style.cssText =
      'position:fixed;inset:auto;margin:0;border:0;overflow:visible;width:auto;height:auto;' +
      'z-index:2147483647;pointer-events:none;background:#000;padding:3px;border-radius:6px;' +
      'box-shadow:0 2px 10px rgba(0,0,0,.6);color:#fff;font:13px sans-serif;text-align:center;';
    pvCanvas = document.createElement('canvas');
    pvCanvas.style.cssText = 'display:block;border-radius:4px;';
    pvLabel = document.createElement('div');
    pvLabel.style.cssText = 'margin-top:2px;height:17px;line-height:17px;';
    pvEl.appendChild(pvCanvas);
    pvEl.appendChild(pvLabel);
    pvCtx = pvCanvas.getContext('2d');
    if (typeof pvEl.showPopover === 'function') {
      pvEl.setAttribute('popover', 'manual');
      pvPopover = true;
    }
  }

  function showPreviewAt(v, r, x, t) {
    if (!document.body) return;
    if (!pvEl) buildPreviewBox();
    var ar = v.videoWidth > 0 ? v.videoHeight / v.videoWidth : 9 / 16;
    var w = PREVIEW_W;
    var h = Math.round(w * ar);
    if (pvCanvas.width !== w) pvCanvas.width = w;
    if (pvCanvas.height !== h) pvCanvas.height = h;
    pvCanvas.style.width = w + 'px';
    pvCanvas.style.height = h + 'px';
    pvLabel.textContent = fmt(t);
    var boxW = w + 6;
    var boxH = h + 6 + 19;
    var left = x - boxW / 2;
    left = Math.max(r.left + 4, Math.min(left, r.right - boxW - 4));
    var top = r.bottom - BAND_MAX - 8 - boxH;
    top = Math.max(top, Math.max(r.top, 0) + 4);
    pvEl.style.left = left + 'px';
    pvEl.style.top = top + 'px';
    if (pvPopover) {
      // it must be part of the page before it can be shown as a popover
      if (pvEl.parentNode !== document.body) document.body.appendChild(pvEl);
      var isOpen = false;
      try { isOpen = pvEl.matches(':popover-open'); } catch (e1) {}
      if (!isOpen) {
        try { pvEl.showPopover(); } catch (e2) {}
      }
    } else {
      var hst = host();
      if (pvEl.parentNode !== hst) hst.appendChild(pvEl);
      pvEl.style.display = 'block';
    }
  }

  function hidePreview() {
    clearTimeout(pvIdle);
    pvPending = -1;
    if (!pvEl) return;
    if (pvPopover) {
      try { pvEl.hidePopover(); } catch (err) {}
    } else {
      pvEl.style.display = 'none';
    }
  }

  function onHover(e) {
    if (!PREVIEW_ENABLED) return;
    var v = getVideo();
    if (!v) {
      hidePreview();
      return;
    }
    var r = v.getBoundingClientRect();
    var fromBottom = r.bottom - e.clientY;
    var inside = true;
    if (e.clientX < r.left) inside = false;
    if (e.clientX > r.right) inside = false;
    if (fromBottom < BAND_MIN) inside = false;
    if (fromBottom > BAND_MAX) inside = false;
    if (!inside) {
      hidePreview();
      return;
    }
    if (v.classList.contains(HIDE_CLASS)) {   // the control bar is hidden right now
      hidePreview();
      return;
    }
    if (!(v.duration > 0)) return;
    if (!isFinite(v.duration)) return;
    if (!ensurePreview(v)) return;
    if (pvFailed) return;

    var f = (e.clientX - (r.left + SIDE_PAD)) / (r.width - 2 * SIDE_PAD);
    if (f < 0) f = 0;
    if (f > 1) f = 1;
    var t = f * v.duration;
    seekPreview(t);
    showPreviewAt(v, r, e.clientX, t);

    // the video's own control bar fades after a while, so does the preview
    clearTimeout(pvIdle);
    pvIdle = setTimeout(hidePreview, 2500);
  }
  window.addEventListener('mousemove', onHover, { capture: true, passive: true });
  document.addEventListener('mouseleave', hidePreview);
  document.addEventListener('mouseout', function (e) {
    if (!e.relatedTarget) hidePreview();
  }, true);
  // Entering or leaving full screen: put the preview back in front
  document.addEventListener('fullscreenchange', function () {
    if (!pvEl) return;
    if (!pvPopover) return;
    var isOpen = false;
    try { isOpen = pvEl.matches(':popover-open'); } catch (e1) {}
    if (isOpen) {
      try { pvEl.hidePopover(); } catch (e2) {}
      try { pvEl.showPopover(); } catch (e3) {}
    }
  });

  function endFast() {
    clearTimeout(holdTimer);
    if (fastActive) {
      var v = getVideo();
      if (v) {
        v.playbackRate = savedRate;
        releaseFocus(v);
      }
      toast(savedRate + 'x');
    }
    fastActive = false;
    spaceDown = false;
  }

  // Keep 2x if the site tries to reset the speed while Space is held
  window.addEventListener('ratechange', function (e) {
    if (!fastActive) return;
    if (!(e.target instanceof HTMLMediaElement)) return;
    if (e.target.playbackRate !== holdRate) e.target.playbackRate = holdRate;
  }, true);

  // Remember where the mouse is (used only when VOLUME_ONLY_OVER_VIDEO is true)
  var mouseX = -1;
  var mouseY = -1;
  window.addEventListener('mousemove', function (e) {
    mouseX = e.clientX;
    mouseY = e.clientY;
  }, { capture: true, passive: true });

  function mouseOverVideo(v) {
    if (document.fullscreenElement) return true;
    var r = v.getBoundingClientRect();
    if (mouseX < r.left) return false;
    if (mouseX > r.right) return false;
    if (mouseY < r.top) return false;
    if (mouseY > r.bottom) return false;
    return true;
  }

  // Volume up (dir = 1) or down (dir = -1) in fixed steps, between 0% and 100%
  function changeVolume(v, dir) {
    var cur = v.volume;
    var next = Math.round((cur + dir * VOL_STEP) * 100) / 100;
    if (next > 1) next = 1;
    if (next < 0) next = 0;
    if (dir > 0 && v.muted) v.muted = false;
    v.volume = next;
    var label = 'Volume ' + Math.round(next * 100) + '%';
    if (next === cur) label = label + (dir > 0 ? ' (max)' : ' (min)');
    if (v.muted) label = label + ' (muted)';
    toast(label);
  }

  // Move to the next speed step up (dir = 1) or down (dir = -1)
  function changeSpeed(v, dir) {
    var cur = fastActive ? savedRate : v.playbackRate;
    var next = cur;
    var i;
    if (dir > 0) {
      next = SPEEDS[SPEEDS.length - 1];
      for (i = 0; i < SPEEDS.length; i++) {
        if (SPEEDS[i] > cur + 0.001) { next = SPEEDS[i]; break; }
      }
    } else {
      next = SPEEDS[0];
      for (i = SPEEDS.length - 1; i >= 0; i--) {
        if (SPEEDS[i] < cur - 0.001) { next = SPEEDS[i]; break; }
      }
    }
    if (fastActive) {
      savedRate = next;   // applied when Space is released
    } else {
      v.playbackRate = next;
    }
    var label = next + 'x';
    if (next === cur) label = dir > 0 ? next + 'x (max)' : next + 'x (normal)';
    toast(label);
  }

  window.addEventListener('keydown', function (e) {
    if (isTyping(e)) return;
    if (e.ctrlKey) return;
    if (e.metaKey) return;
    if (e.altKey) return;

    if (isSpace(e)) {
      // Always block the site's own Space handling; we do play/pause ourselves on release
      e.preventDefault();
      e.stopImmediatePropagation();
      if (spaceDown) return; // ignore auto-repeat while held
      spaceDown = true;
      fastActive = false;
      holdTimer = setTimeout(function () {
        var v = getVideo();
        if (!v) return;
        if (!spaceDown) return;
        fastActive = true;
        savedRate = v.playbackRate;
        holdRate = Math.max(FAST, savedRate);
        v.playbackRate = holdRate;
        toast(holdRate + 'x');
      }, HOLD_MS);
      return;
    }

    var v2 = getVideo();
    if (!v2) return;

    // Shift + Up / Shift + Down = speed steps
    var isSpeedKey = false;
    if (e.shiftKey) {
      if (e.key === 'ArrowUp') isSpeedKey = true;
      if (e.key === 'ArrowDown') isSpeedKey = true;
    }
    if (isSpeedKey) {
      e.preventDefault();
      e.stopImmediatePropagation();
      if (e.repeat) return; // one step per key press
      changeSpeed(v2, e.key === 'ArrowUp' ? 1 : -1);
      releaseFocus(v2);
      if (v2.paused) armHide(v2);
      return;
    }

    // Up / Down (without Shift) = volume
    var isVolKey = false;
    if (!e.shiftKey) {
      if (e.key === 'ArrowUp') isVolKey = true;
      if (e.key === 'ArrowDown') isVolKey = true;
    }
    if (isVolKey) {
      if (VOLUME_ONLY_OVER_VIDEO) {
        if (!mouseOverVideo(v2)) return;
      }
      e.preventDefault();
      e.stopImmediatePropagation();
      changeVolume(v2, e.key === 'ArrowUp' ? 1 : -1);
      releaseFocus(v2);
      if (v2.paused) armHide(v2);
      return;
    }

    var isArrow = false;
    if (e.key === 'ArrowRight') isArrow = true;
    if (e.key === 'ArrowLeft') isArrow = true;

    if (isArrow) {
      e.preventDefault();
      e.stopImmediatePropagation();
      var d = e.key === 'ArrowRight' ? SEEK : -SEEK;
      var dur = v2.duration > 0 ? v2.duration : Infinity;
      v2.currentTime = Math.max(0, Math.min(dur, v2.currentTime + d));
      toast((d > 0 ? '+' : '') + d + 's');
      releaseFocus(v2);
      if (v2.paused) armHide(v2);
    } else if (e.key && e.key.toLowerCase() === 'm' && !e.repeat) {
      e.preventDefault();
      e.stopImmediatePropagation();
      v2.muted = !v2.muted;
      toast(v2.muted ? 'Muted' : 'Unmuted');
      releaseFocus(v2);
      if (v2.paused) armHide(v2);
    }
  }, true);

  window.addEventListener('keyup', function (e) {
    if (!isSpace(e)) return;
    if (!spaceDown) return;
    e.preventDefault();
    e.stopImmediatePropagation();
    var wasFast = fastActive;
    endFast();
    if (!wasFast) {
      // Quick tap: toggle play/pause
      var v = getVideo();
      if (v) {
        if (v.paused) {
          showBar();
          var p = v.play();
          if (p) {
            if (p.catch) p.catch(function () {});
          }
        } else {
          v.pause();
          armHide(v);
        }
        releaseFocus(v);
      }
    }
  }, true);

  // If the window loses focus while Space is held, don't get stuck at 2x
  window.addEventListener('blur', endFast);
})();
